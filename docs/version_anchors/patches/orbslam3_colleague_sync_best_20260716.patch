+int Optimizer::FullFrameBundleAdjustment(vector<Frame*> &vpFrames, int nIterations, const bool bRobust, const int minObservations)
+{
+    vector<Frame*> vpValidFrames;
+    vpValidFrames.reserve(vpFrames.size());
+    unordered_map<MapPoint*, int> mObsCount;
+    vector<pair<Frame*, int> > vSelectedObservations;
+    const int maxObsPerFramePerCamera = 30;
+
+    for(Frame* pFrame : vpFrames)
+    {
+        if(!pFrame || !pFrame->isSet())
+            continue;
+
+        int nLeftObs = 0;
+        int nRightObs = 0;
+        int nMonoObs = 0;
+        const int N = pFrame->N;
+        for(int i = 0; i < N; ++i)
+        {
+            MapPoint* pMP = pFrame->mvpMapPoints[i];
+            if(pMP && !pMP->isBad())
+            {
+                bool bUse = false;
+                if(pFrame->mpCamera2)
+                {
+                    if(i < pFrame->Nleft)
+                    {
+                        bUse = nLeftObs < maxObsPerFramePerCamera;
+                        if(bUse)
+                            ++nLeftObs;
+                    }
+                    else
+                    {
+                        bUse = nRightObs < maxObsPerFramePerCamera;
+                        if(bUse)
+                            ++nRightObs;
+                    }
+                }
+                else
+                {
+                    bUse = nMonoObs < (2 * maxObsPerFramePerCamera);
+                    if(bUse)
+                        ++nMonoObs;
+                }
+
+                if(bUse)
+                {
+                    vSelectedObservations.push_back(make_pair(pFrame, i));
+                    mObsCount[pMP]++;
+                }
+            }
+        }
+
+        if(nLeftObs + nRightObs + nMonoObs > 0)
+            vpValidFrames.push_back(pFrame);
+    }
+
+    if(vpValidFrames.size() < 2 || mObsCount.empty())
+        return 0;
+
+    g2o::SparseOptimizer optimizer;
+    g2o::BlockSolver_6_3::LinearSolverType *linearSolver = new g2o::LinearSolverEigen<g2o::BlockSolver_6_3::PoseMatrixType>();
+    g2o::BlockSolver_6_3 *solver_ptr = new g2o::BlockSolver_6_3(linearSolver);
+    g2o::OptimizationAlgorithmLevenberg *solver = new g2o::OptimizationAlgorithmLevenberg(solver_ptr);
+    optimizer.setAlgorithm(solver);
+    optimizer.setVerbose(false);
+
+    unordered_map<Frame*, int> mFrameVertexId;
+    mFrameVertexId.reserve(vpValidFrames.size());
+    for(size_t i = 0; i < vpValidFrames.size(); ++i)
+    {
+        Frame* pFrame = vpValidFrames[i];
+        g2o::VertexSE3Expmap *vSE3 = new g2o::VertexSE3Expmap();
+        Sophus::SE3<float> Tcw = pFrame->GetPose();
+        vSE3->setEstimate(g2o::SE3Quat(Tcw.unit_quaternion().cast<double>(), Tcw.translation().cast<double>()));
+        vSE3->setId(static_cast<int>(i));
+        vSE3->setFixed(i == 0);
+        optimizer.addVertex(vSE3);
+        mFrameVertexId[pFrame] = static_cast<int>(i);
+    }
+
+    unordered_map<MapPoint*, int> mPointVertexId;
+    mPointVertexId.reserve(mObsCount.size());
+    int nextVertexId = static_cast<int>(vpValidFrames.size());
+    {
+        unique_lock<mutex> lock(MapPoint::mGlobalMutex);
+        for(const auto &item : mObsCount)
+        {
+            MapPoint* pMP = item.first;
+            if(!pMP || pMP->isBad() || item.second < minObservations)
+                continue;
+
+            g2o::VertexSBAPointXYZ *vPoint = new g2o::VertexSBAPointXYZ();
+            vPoint->setEstimate(pMP->GetWorldPos().cast<double>());
+            vPoint->setId(nextVertexId);
+            vPoint->setMarginalized(true);
+            optimizer.addVertex(vPoint);
+            mPointVertexId[pMP] = nextVertexId++;
+        }
+    }
+
+    if(mPointVertexId.empty())
+        return 0;
+
+    const float thHuber2D = sqrt(5.991);
+    const float thHuber3D = sqrt(7.815);
+    int nEdges = 0;
+
+    for(const pair<Frame*, int> &frameObs : vSelectedObservations)
+    {
+        Frame* pFrame = frameObs.first;
+        const int i = frameObs.second;
+        const int frameVertexId = mFrameVertexId[pFrame];
+        MapPoint* pMP = pFrame->mvpMapPoints[i];
+        if(!pMP || pMP->isBad())
+            continue;
+
+        auto pointIt = mPointVertexId.find(pMP);
+        if(pointIt == mPointVertexId.end())
+            continue;
+
+        const int pointVertexId = pointIt->second;
+
+        if(!pFrame->mpCamera2)
+        {
+            if(pFrame->mvuRight[i] < 0)
+            {
+                const cv::KeyPoint &kpUn = pFrame->mvKeysUn[i];
+                Eigen::Matrix<double, 2, 1> obs;
+                obs << kpUn.pt.x, kpUn.pt.y;
+
+                ORB_SLAM3::EdgeSE3ProjectXYZ *e = new ORB_SLAM3::EdgeSE3ProjectXYZ();
+                e->setVertex(0, dynamic_cast<g2o::OptimizableGraph::Vertex *>(optimizer.vertex(pointVertexId)));
+                e->setVertex(1, dynamic_cast<g2o::OptimizableGraph::Vertex *>(optimizer.vertex(frameVertexId)));
+                e->setMeasurement(obs);
+                e->setInformation(Eigen::Matrix2d::Identity() * pFrame->mvInvLevelSigma2[kpUn.octave]);
+                if(bRobust)
+                {
+                    g2o::RobustKernelHuber *rk = new g2o::RobustKernelHuber;
+                    e->setRobustKernel(rk);
+                    rk->setDelta(thHuber2D);
+                }
+                e->pCamera = pFrame->mpCamera;
+                optimizer.addEdge(e);
+                ++nEdges;
+            }
+            else
+            {
+                const cv::KeyPoint &kpUn = pFrame->mvKeysUn[i];
+                Eigen::Matrix<double, 3, 1> obs;
+                obs << kpUn.pt.x, kpUn.pt.y, pFrame->mvuRight[i];
+
+                g2o::EdgeStereoSE3ProjectXYZ *e = new g2o::EdgeStereoSE3ProjectXYZ();
+                e->setVertex(0, dynamic_cast<g2o::OptimizableGraph::Vertex *>(optimizer.vertex(pointVertexId)));
+                e->setVertex(1, dynamic_cast<g2o::OptimizableGraph::Vertex *>(optimizer.vertex(frameVertexId)));
+                e->setMeasurement(obs);
+                e->setInformation(Eigen::Matrix3d::Identity() * pFrame->mvInvLevelSigma2[kpUn.octave]);
+                if(bRobust)
+                {
+                    g2o::RobustKernelHuber *rk = new g2o::RobustKernelHuber;
+                    e->setRobustKernel(rk);
+                    rk->setDelta(thHuber3D);
+                }
+                e->fx = pFrame->fx;
+                e->fy = pFrame->fy;
+                e->cx = pFrame->cx;
+                e->cy = pFrame->cy;
+                e->bf = pFrame->mbf;
+                optimizer.addEdge(e);
+                ++nEdges;
+            }
+        }
+        else
+        {
+            if(i < pFrame->Nleft)
+            {
+                const cv::KeyPoint &kp = pFrame->mvKeys[i];
+                Eigen::Matrix<double, 2, 1> obs;
+                obs << kp.pt.x, kp.pt.y;
+
+                ORB_SLAM3::EdgeSE3ProjectXYZ *e = new ORB_SLAM3::EdgeSE3ProjectXYZ();
+                e->setVertex(0, dynamic_cast<g2o::OptimizableGraph::Vertex *>(optimizer.vertex(pointVertexId)));
+                e->setVertex(1, dynamic_cast<g2o::OptimizableGraph::Vertex *>(optimizer.vertex(frameVertexId)));
+                e->setMeasurement(obs);
+                e->setInformation(Eigen::Matrix2d::Identity() * pFrame->mvInvLevelSigma2[kp.octave]);
+                if(bRobust)
+                {
+                    g2o::RobustKernelHuber *rk = new g2o::RobustKernelHuber;
+                    e->setRobustKernel(rk);
+                    rk->setDelta(thHuber2D);
+                }
+                e->pCamera = pFrame->mpCamera;
+                optimizer.addEdge(e);
+                ++nEdges;
+            }
+            else
+            {
+                const int rightIndex = i - pFrame->Nleft;
+                if(rightIndex < 0 || rightIndex >= static_cast<int>(pFrame->mvKeysRight.size()))
+                    continue;
+
+                const cv::KeyPoint &kp = pFrame->mvKeysRight[rightIndex];
+                Eigen::Matrix<double, 2, 1> obs;
+                obs << kp.pt.x, kp.pt.y;
+
+                ORB_SLAM3::EdgeSE3ProjectXYZToBody *e = new ORB_SLAM3::EdgeSE3ProjectXYZToBody();
+                e->setVertex(0, dynamic_cast<g2o::OptimizableGraph::Vertex *>(optimizer.vertex(pointVertexId)));
+                e->setVertex(1, dynamic_cast<g2o::OptimizableGraph::Vertex *>(optimizer.vertex(frameVertexId)));
+                e->setMeasurement(obs);
+                e->setInformation(Eigen::Matrix2d::Identity() * pFrame->mvInvLevelSigma2[kp.octave]);
+                if(bRobust)
+                {
+                    g2o::RobustKernelHuber *rk = new g2o::RobustKernelHuber;
+                    e->setRobustKernel(rk);
+                    rk->setDelta(thHuber2D);
+                }
+                Sophus::SE3f Trl = pFrame->GetRelativePoseTrl();
+                e->mTrl = g2o::SE3Quat(Trl.unit_quaternion().cast<double>(), Trl.translation().cast<double>());
+                e->pCamera = pFrame->mpCamera2;
+                optimizer.addEdge(e);
+                ++nEdges;
+            }
+        }
+    }
+
+    if(nEdges < 10)
+        return 0;
+
+    optimizer.initializeOptimization();
+    optimizer.optimize(nIterations);
+
+    for(Frame* pFrame : vpValidFrames)
+    {
+        const int vertexId = mFrameVertexId[pFrame];
+        g2o::VertexSE3Expmap *vSE3 = static_cast<g2o::VertexSE3Expmap *>(optimizer.vertex(vertexId));
+        if(!vSE3)
+            continue;
+        g2o::SE3Quat SE3quat = vSE3->estimate();
+        pFrame->SetPose(Sophus::SE3f(SE3quat.rotation().cast<float>(), SE3quat.translation().cast<float>()));
+    }
+
+    {
+        unique_lock<mutex> lock(MapPoint::mGlobalMutex);
+        for(const auto &item : mPointVertexId)
+        {
+            MapPoint* pMP = item.first;
+            if(!pMP || pMP->isBad())
+                continue;
+            g2o::VertexSBAPointXYZ *vPoint = static_cast<g2o::VertexSBAPointXYZ *>(optimizer.vertex(item.second));
+            if(!vPoint)
+                continue;
+            pMP->SetWorldPos(vPoint->estimate().cast<float>());
+            pMP->UpdateNormalAndDepth();
+        }
+    }
+
+    return nEdges;
+}
