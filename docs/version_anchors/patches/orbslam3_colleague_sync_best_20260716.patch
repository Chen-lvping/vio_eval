+bool System::RunFullFrameBundleAdjustment(const int nIterations, const bool bRobust)
+{
+    if(nIterations <= 0)
+        return true;
+
+    if(!mpTracker)
+        return false;
+
+    vector<Frame*> vpFrames;
+    vpFrames.reserve(mpTracker->mlFullFrameBAFrames.size());
+    for(Frame &frame : mpTracker->mlFullFrameBAFrames)
+    {
+        if(frame.isSet())
+            vpFrames.push_back(&frame);
+    }
+
+    if(vpFrames.empty())
+    {
+        cerr << "[Offline] No valid tracked frames for Full-Frame Bundle Adjustment" << endl;
+        return false;
+    }
+
+    cout << "[Offline] Running Full-Frame Pose-Only Visual BA with " << vpFrames.size()
+         << " frames, passes=" << nIterations << ", robust=" << bRobust << endl;
+
+    int nOptimized = 0;
+    int nSkipped = 0;
+    long unsigned int nTotalInliers = 0;
+    for(int pass = 0; pass < nIterations; ++pass)
+    {
+        int nPassOptimized = 0;
+        int nPassSkipped = 0;
+        long unsigned int nPassInliers = 0;
+        for(Frame* pFrame : vpFrames)
+        {
+            int nValidMapPoints = 0;
+            for(MapPoint* &pMP : pFrame->mvpMapPoints)
+            {
+                if(pMP && pMP->isBad())
+                    pMP = static_cast<MapPoint*>(NULL);
+                if(pMP)
+                    ++nValidMapPoints;
+            }
+
+            if(nValidMapPoints < 10)
+            {
+                ++nPassSkipped;
+                continue;
+            }
+
+            const int nInliers = Optimizer::PoseOptimization(pFrame);
+            if(nInliers > 0)
+            {
+                ++nPassOptimized;
+                nPassInliers += nInliers;
+            }
+            else
+            {
+                ++nPassSkipped;
+            }
+        }
+
+        nOptimized = nPassOptimized;
+        nSkipped = nPassSkipped;
+        nTotalInliers = nPassInliers;
+        cout << "[Offline] Full-Frame Pose-Only Visual BA pass " << (pass + 1)
+             << "/" << nIterations << ": optimized_frames=" << nPassOptimized
+             << ", skipped_frames=" << nPassSkipped
+             << ", mean_inliers="
+             << (nPassOptimized > 0 ? static_cast<double>(nPassInliers) / nPassOptimized : 0.0)
+             << endl;
+    }
+
+    cout << "[Offline] Full-Frame Pose-Only Visual BA finished: optimized_frames="
+         << nOptimized << ", skipped_frames=" << nSkipped << ", total_inliers="
+         << nTotalInliers << endl;
+
+    int nRewritten = 0;
+    list<Frame>::iterator lFit = mpTracker->mlFullFrameBAFrames.begin();
+    list<ORB_SLAM3::KeyFrame*>::iterator lRit = mpTracker->mlpReferences.begin();
+    list<double>::iterator lT = mpTracker->mlFrameTimes.begin();
+    list<bool>::iterator lbL = mpTracker->mlbLost.begin();
+    for(list<Sophus::SE3f>::iterator lit = mpTracker->mlRelativeFramePoses.begin(),
+        lend = mpTracker->mlRelativeFramePoses.end();
+        lit != lend && lRit != mpTracker->mlpReferences.end() &&
+        lT != mpTracker->mlFrameTimes.end() && lbL != mpTracker->mlbLost.end();
+        ++lit, ++lRit, ++lT, ++lbL)
+    {
+        if(*lbL)
+            continue;
+
+        while(lFit != mpTracker->mlFullFrameBAFrames.end() && lFit->mTimeStamp + 1e-9 < *lT)
+            ++lFit;
+
+        if(lFit == mpTracker->mlFullFrameBAFrames.end())
+            break;
+
+        if(fabs(lFit->mTimeStamp - *lT) > 1e-6)
+            continue;
+
+        KeyFrame* pKF = *lRit;
+        if(!pKF)
+            continue;
+
+        *lit = lFit->GetPose() * pKF->GetPoseInverse();
+        ++nRewritten;
+        ++lFit;
+    }
+
+    cout << "[Offline] Rewrote " << nRewritten
+         << " relative frame poses with full-frame optimized poses" << endl;
+    return nOptimized > 0;
+}
+
+void System::SaveFullFrameBATrajectoryEuRoC(const string &filename)
+{
+    cout << endl << "Saving full-frame BA trajectory to " << filename << " ..." << endl;
+    if(!mpTracker)
+    {
+        cerr << "ERROR: tracker is not available." << endl;
+        return;
+    }
+
+    ofstream f;
+    f.open(filename.c_str());
+    f << fixed;
+
+    vector<Map*> vpMaps = mpAtlas->GetAllMaps();
+    int numMaxKFs = 0;
+    Map* pBiggerMap = static_cast<Map*>(NULL);
+    for(Map* pMap : vpMaps)
+    {
+        if(pMap && !pMap->IsBad() && static_cast<int>(pMap->GetAllKeyFrames().size()) > numMaxKFs)
+        {
+            numMaxKFs = static_cast<int>(pMap->GetAllKeyFrames().size());
+            pBiggerMap = pMap;
+        }
+    }
+
+    if(!pBiggerMap || numMaxKFs == 0)
+    {
+        cerr << "ERROR: no valid map is available for full-frame BA trajectory." << endl;
+        f.close();
+        return;
+    }
+
+    vector<KeyFrame*> vpKFs = pBiggerMap->GetAllKeyFrames();
+    sort(vpKFs.begin(), vpKFs.end(), KeyFrame::lId);
+
+    Sophus::SE3f Twb;
+    if(mSensor == IMU_MONOCULAR || mSensor == IMU_STEREO || mSensor == IMU_RGBD)
+        Twb = vpKFs[0]->GetImuPose();
+    else
+        Twb = vpKFs[0]->GetPoseInverse();
+
+    for(Frame &frame : mpTracker->mlFullFrameBAFrames)
+    {
+        if(!frame.isSet())
+            continue;
+        Sophus::SE3f Twc = (frame.GetPose() * Twb).inverse();
+        Eigen::Quaternionf q = Twc.unit_quaternion();
+        Eigen::Vector3f twc = Twc.translation();
+        f << setprecision(6) << 1e9 * frame.mTimeStamp << " " << setprecision(9)
+          << twc(0) << " " << twc(1) << " " << twc(2) << " "
+          << q.x() << " " << q.y() << " " << q.z() << " " << q.w() << endl;
+    }
+
+    f.close();
+    cout << endl << "End of saving full-frame BA trajectory to " << filename << " ..." << endl;
+}
