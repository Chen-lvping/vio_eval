+bool System::WaitForLocalMappingIdle(double timeoutSec)
+{
+    if(!mpLocalMapper)
+        return true;
+
+    const std::chrono::steady_clock::time_point deadline =
+        std::chrono::steady_clock::now() + std::chrono::duration<double>(timeoutSec);
+    while(mpLocalMapper->KeyframesInQueue() > 0 || !mpLocalMapper->AcceptKeyFrames() || mpLocalMapper->IsInitializing())
+    {
+        if(std::chrono::steady_clock::now() >= deadline)
+            return false;
+        usleep(1000);
+    }
+    return true;
+}
